+	/**
+	 * Convert whistle contours to an average normalised spectrum using explicit bin edges
+	 * (e.g. fractional-octave bands). Same counting rules as the 100 Hz version.
+	 * @param whistleValues - the whistle contour values (column 1 time in seconds, column 2 frequency).
+	 * @param startseg - the start segment in seconds.
+	 * @param seglen - the segment length (same units as the 100 Hz version).
+	 * @param binEdges - n+1 bin edges in Hz.
+	 * @param explicitEdges - marker to distinguish from the 100 Hz overload.
+	 * @return the normalised histogram.
+	 */
+	public static double[] whistle2AverageArray(double[][] whistleValues, double startseg, double seglen, double[] binEdges, boolean explicitEdges) {
+		int nbins = binEdges.length - 1;
+		double[] peakBins = new double[nbins];
+		int ntot = 0;
+		for (int i=0; i<nbins; i++) {
+			int n=0;
+			for (int j=0; j<whistleValues.length ; j++) {
+				if (whistleValues[j][1]>= binEdges[i] && whistleValues[j][1]< binEdges[i+1] && whistleValues[j][0]>=startseg && whistleValues[j][0]<(startseg+seglen)) {
+					n++;
+				}
+			}
+			ntot=ntot+n;
+			peakBins[i]=n;
+		}
+		if (ntot!=0) {
+			for (int i=0; i<nbins; i++) {
+				peakBins[i]=peakBins[i]/ntot;
+			}
+		}
+		return peakBins;
+	}
+
+	/**
+	 * Edges of fractional-octave bands (base 2, centres 1000*2^(n/b) Hz) whose centres lie within
+	 * freqLimits widened by half a band. Matches speciesclassifiers' octave_band_edges().
+	 */
+	public static double[] octaveBandEdges(double[] freqLimits, int bandsPerOctave) {
+		double b = bandsPerOctave;
+		double half = Math.pow(2.0, 1.0/(2.0*b));
+		int n0 = (int) Math.ceil(b * (Math.log(freqLimits[0]/half/1000.0)/Math.log(2.0)) - 1e-9);
+		int n1 = (int) Math.floor(b * (Math.log(freqLimits[1]*half/1000.0)/Math.log(2.0)) + 1e-9);
+		double[] edges = new double[n1 - n0 + 2];
+		for (int n = n0; n <= n1; n++) {
+			edges[n - n0] = 1000.0 * Math.pow(2.0, n/b) / half;
+		}
+		edges[n1 - n0 + 1] = 1000.0 * Math.pow(2.0, n1/b) * half;
+		return edges;
+	}
